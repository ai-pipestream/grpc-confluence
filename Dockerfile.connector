FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY . .
RUN ./gradlew --no-daemon build :grpc-microsoft-connector:installDist

FROM eclipse-temurin:25-jre
COPY --from=build /src/grpc-microsoft-connector/build/install/grpc-microsoft-connector /opt/connector
RUN useradd --system --no-create-home connector
USER connector
EXPOSE 30303
ENTRYPOINT ["/opt/connector/bin/grpc-microsoft-connector"]
